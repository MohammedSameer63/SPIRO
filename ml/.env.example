# SPIRO ML — Environment Configuration
# Copy to .env and fill in values

# Device
CUDA_VISIBLE_DEVICES=0
OMP_NUM_THREADS=4

# MLflow
MLFLOW_TRACKING_URI=logs/mlflow
MLFLOW_EXPERIMENT_NAME=spiro_ml

# Paths (override config defaults)
SPIRO_DATA_ROOT=datasets
SPIRO_MODELS_ROOT=models

# Logging
SPIRO_LOG_LEVEL=INFO
