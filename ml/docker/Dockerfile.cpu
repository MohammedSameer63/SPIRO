# SPIRO ML — CPU Inference Dockerfile
# Multi-stage build: builder installs deps, final is lean production image
# Usage:
#   docker build -f docker/Dockerfile.cpu -t spiro-ml-cpu:latest .
#   docker run --rm -v $(pwd)/models:/app/models -p 8080:8080 spiro-ml-cpu:latest

FROM python:3.11-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libgomp1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    onnxruntime==1.18.1 \
    opencv-python-headless \
    numpy pillow pyyaml omegaconf scipy \
    onnx onnxsim \
    && pip install --no-cache-dir -r requirements.txt

# ── Production stage ─────────────────────────────────────────────────────────
FROM python:3.11-slim AS production

LABEL maintainer="spiro@example.com" \
      version="1.0.0" \
      description="SPIRO ML CPU inference service"

WORKDIR /app

# Runtime system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libglib2.0-0 libsm6 libxext6 libxrender-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages
COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY src/ /app/src/
COPY configs/ /app/configs/
COPY training/ /app/training/
COPY scripts/ /app/scripts/

# Create runtime directories
RUN mkdir -p /app/models/current /app/logs /app/reports /app/mlops

# Environment
ENV PYTHONPATH=/app/src
ENV ORT_LOGGING_LEVEL=3
ENV SPIRO_ENV=production
ENV SPIRO_DEVICE=cpu

# Non-root user for security
RUN useradd -m -u 1001 spiroml && chown -R spiroml:spiroml /app
USER spiroml

# Healthcheck: verify pipeline can load and run a dummy inference
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python /app/scripts/healthcheck.py || exit 1

EXPOSE 8080

CMD ["python", "/app/training/infer_pipeline.py", "--help"]
