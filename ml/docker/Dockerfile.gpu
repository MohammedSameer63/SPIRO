# SPIRO ML — GPU Inference Dockerfile (CUDA 12.1)
# Requires: nvidia-docker2 or Docker >= 19.03 with --gpus flag
# Usage:
#   docker build -f docker/Dockerfile.gpu -t spiro-ml-gpu:latest .
#   docker run --gpus all --rm -v $(pwd)/models:/app/models spiro-ml-gpu:latest

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-dev python3-pip \
    build-essential libgomp1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3.11 /usr/bin/python
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    onnxruntime-gpu==1.18.1 \
    torch==2.3.1 torchvision \
    opencv-python-headless numpy pillow pyyaml omegaconf scipy timm \
    onnx onnxsim \
    && pip install --no-cache-dir -r requirements.txt

# ── Production stage ─────────────────────────────────────────────────────────
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 AS production

LABEL maintainer="spiro@example.com" \
      description="SPIRO ML GPU inference service (CUDA 12.1)"

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 libgomp1 libglib2.0-0 libsm6 curl \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3.11 /usr/bin/python

COPY --from=builder /usr/local/lib/python3 /usr/local/lib/python3
COPY --from=builder /usr/local/bin /usr/local/bin

COPY src/ /app/src/
COPY configs/ /app/configs/
COPY training/ /app/training/
COPY scripts/ /app/scripts/

RUN mkdir -p /app/models/current /app/logs /app/reports /app/mlops
RUN useradd -m -u 1001 spiroml && chown -R spiroml:spiroml /app
USER spiroml

ENV PYTHONPATH=/app/src
ENV ORT_LOGGING_LEVEL=3
ENV SPIRO_ENV=production
ENV SPIRO_DEVICE=cuda
ENV CUDA_VISIBLE_DEVICES=0

HEALTHCHECK --interval=30s --timeout=15s --start-period=90s --retries=3 \
    CMD python /app/scripts/healthcheck.py || exit 1

EXPOSE 8080
CMD ["python", "/app/training/infer_pipeline.py", "--benchmark", "--n-runs", "10"]
