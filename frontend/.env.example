# ============================================================
# SPIRO Frontend — environment template
# Copy to .env for local dev, or set at build time for hosting:
#   cp .env.example .env
#
# Production build (static hosting):
#   VITE_API_BASE_URL=https://your-backend-domain/api/v1 npm run build
# ============================================================

# Local backend (matches `vite.config.ts` proxy / direct URL)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
