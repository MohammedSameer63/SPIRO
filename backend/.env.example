# ============================================================
# SPIRO Backend — environment template
# Copy to .env and fill in real values:
#   cp .env.example .env
# NEVER commit .env (it holds secrets).
# ============================================================

# --- Database ---
# Local dev:
DATABASE_URL=postgresql://spiro_user:Spiro123@localhost:5432/spiro
# Docker compose (the compose file overrides this automatically):
# DATABASE_URL=postgresql://spiro:spiro@db:5432/spiro
# Managed Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/spiro

# --- Auth ---
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
# Local dev default covers `npm run dev`; add your hosted frontend domain.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10

# --- ML inference (runs inside this backend) ---
ML_ENABLED=true
ML_MOCK_MODE=false
ML_CONFIDENCE_THRESHOLD=0.25
ML_SERVICE_API_KEY=my-long-random-secret

# --- Household QR validation ---
# Secret used to sign household QR payloads. Must be identical on every
# backend instance that issues/verifies QR codes.
QR_SECRET_KEY=change-this-to-a-long-random-string

# --- Green coins (citizen rewards) ---
# Coins awarded when a worker marks a report COMPLETED...
COINS_PER_COMPLETION=10
# ...plus this bonus when the pickup was QR-validated at collection.
COINS_QR_BONUS=5
